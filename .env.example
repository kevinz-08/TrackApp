# ── Base de datos (Neon) ──────────────────────────────
# Pooled (host con "-pooler"): la usa la app en runtime.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/trackapp?sslmode=require"
# Directa: solo para `prisma migrate`, que necesita sesión persistente.
DIRECT_URL="postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/trackapp?sslmode=require"

# ── Autenticación (Auth.js v5) ────────────────────────
# Generar con: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# ── IA (Groq) ─────────────────────────────────────────
# Opcional: sin esta clave la app funciona, solo se apaga el chat y el
# fallback de parsing (principio 3: la IA no es crítica).
GROQ_API_KEY=""

# ── Imágenes (Cloudinary) ─────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# ── Cron ──────────────────────────────────────────────
# Generar con: openssl rand -hex 32
CRON_SECRET=""

# ── Push (Web Push VAPID) ─────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:kevingadev@gmail.com"

# ── App ───────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Seed (opcional) ───────────────────────────────────
SEED_USER_EMAIL="kevingadev@gmail.com"
SEED_USER_PASSWORD=""
SEED_USER_NAME="Santiago"
